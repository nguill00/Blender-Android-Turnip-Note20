diff --git a/intern/cycles/util/simd.h b/intern/cycles/util/simd.h
index 73c94b0..db9211f 100644
--- a/intern/cycles/util/simd.h
+++ b/intern/cycles/util/simd.h
@@ -5,6 +5,27 @@
 
 #pragma once
 
+/* CHATPATCH-BEGIN ANDROID-CYCLES-SSE2NEON */
+/*
+ * Cycles uses x86 SSE names internally.  On Android arm64 they are
+ * provided by sse2neon.  Pull it in before Cycles declares/uses
+ * __m128/__m128i and the NEON table types.
+ */
+#if defined(__ANDROID__) && defined(__aarch64__) && defined(WITH_SSE2NEON)
+#  ifndef SSE2NEON_PRECISE_MINMAX
+#    define SSE2NEON_PRECISE_MINMAX 1
+#  endif
+#  ifndef SSE2NEON_PRECISE_DIV
+#    define SSE2NEON_PRECISE_DIV 1
+#  endif
+#  ifndef SSE2NEON_PRECISE_SQRT
+#    define SSE2NEON_PRECISE_SQRT 1
+#  endif
+#  include <sse2neon.h>
+#endif
+/* CHATPATCH-END ANDROID-CYCLES-SSE2NEON */
+
+
 #include <cstdint>
 #include <limits>
 
diff --git a/source/blender/gpu/intern/gpu_context.cc b/source/blender/gpu/intern/gpu_context.cc
index 83d4633..8357dcc 100644
--- a/source/blender/gpu/intern/gpu_context.cc
+++ b/source/blender/gpu/intern/gpu_context.cc
@@ -207,6 +207,31 @@ GPUContext *GPU_context_create(GHOST_IWindow *ghost_window, GHOST_IContext *ghos
   }
   Context *ctx = GPUBackend::get()->context_alloc(ghost_window, ghost_context);
 
+  /* CHATPATCH-BEGIN ANDROID-GPU-CONTEXT-GUARD
+   *
+   * On Android a Vulkan backend can fail device creation after the
+   * compatibility probe rejects the system driver.  Do not continue into
+   * DebugDraw with a null GPU context; that was the exact Note20 crash:
+   * GPU_storagebuf_update -> DebugDraw::reset -> GPU_context_create.
+   */
+  if (ctx == nullptr) {
+    fprintf(stderr,
+            "[BlenderAndroid] GPU context creation failed; "
+            "renderer backend did not provide a usable device.\n");
+
+    {
+      std::scoped_lock lock(backend_users_mutex);
+      num_backend_users--;
+      BLI_assert(num_backend_users >= 0);
+      if (num_backend_users == 0) {
+        gpu_backend_discard();
+      }
+    }
+
+    return nullptr;
+  }
+  /* CHATPATCH-END ANDROID-GPU-CONTEXT-GUARD */
+
   GPU_context_active_set(wrap(ctx));
 
   draw::DebugDraw::get().acquire();
